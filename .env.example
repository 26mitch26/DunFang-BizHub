# Database
DB_URL=jdbc:mysql://localhost:3306/dunfang_bizhub?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-jwt-secret-at-least-256-bits-long
JWT_ACCESS_EXPIRATION=7200000
JWT_REFRESH_EXPIRATION=604800000

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=dunfang
MINIO_SECRET_KEY=your_minio_secret
MINIO_BUCKET=dunfang-bizhub

# AI Worker
AI_WORKER_URL=http://localhost:8001
DASHSCOPE_API_KEY=your_dashscope_api_key

# Server
SERVER_PORT=8080
LOG_LEVEL=debug
